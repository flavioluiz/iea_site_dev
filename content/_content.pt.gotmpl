{{ range .Site.Data.paginas }}
  {{ if and (eq .tipo "pagina_editavel") .pagina.publicada }}
    {{ $params := dict "description" .pagina.descricao.pt "site_page_id" .id "type" "paginas" }}
    {{ $content := dict "mediaType" "text/markdown" "value" .pagina.conteudo.pt }}
    {{ $page := dict "content" $content "kind" "page" "path" .pagina.slug "title" .pagina.titulo.pt "params" $params }}
    {{ $.AddPage $page }}
  {{ end }}
{{ end }}
