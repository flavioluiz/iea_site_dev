{{- $nodes := slice -}}
{{- $editors := .Site.Data.admin.paginas_edicao -}}
{{- range .Site.Data.paginas -}}
  {{- $edicao := index $editors .id | default dict -}}
  {{- $nodes = $nodes | append (dict
    "id" .id
    "tipo" .tipo
    "protegido" .protegido
    "parent" .parent
    "ordem" .ordem
    "visivel" .visivel
    "rotulo" .rotulo
    "url" .url
    "pagina" (dict "slug" .pagina.slug "publicada" .pagina.publicada)
    "edicao" $edicao
  ) -}}
{{- end -}}
{{- dict "version" 2 "nodes" $nodes | jsonify -}}
