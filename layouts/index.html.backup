{{ define "main" }}
<!-- Hero Section -->
<section class="bg-gradient-to-r from-blue-900 to-blue-700 text-white py-16 -mx-4 mb-12 px-4">
  <div class="container mx-auto max-w-7xl">
    <h1 class="text-4xl md:text-5xl font-bold mb-4">
      {{ i18n "welcome_message" }}
    </h1>
    <p class="text-xl text-blue-100 mb-6">
      {{ i18n "program_description" }}
    </p>
    <div class="flex flex-wrap gap-4">
      <a href="{{ relLangURL "/areas/" }}"
         class="bg-white text-blue-900 px-6 py-3 rounded-lg font-semibold hover:bg-blue-50 transition-colors">
        {{ i18n "research_areas" }}
      </a>
      <a href="{{ relLangURL "/processo-seletivo/" }}"
         class="bg-blue-600 text-white px-6 py-3 rounded-lg font-semibold hover:bg-blue-500 transition-colors border-2 border-white">
        {{ i18n "admission" }}
      </a>
    </div>
  </div>
</section>

<!-- Coordinator Info -->
<section class="mb-12">
  <div class="bg-white rounded-lg shadow-md p-6">
    <h2 class="text-2xl font-bold text-gray-900 mb-4">{{ i18n "coordinator" }}</h2>
    <div class="flex items-center gap-4">
      <div>
        <p class="text-lg font-semibold text-gray-900">
          {{ .Site.Params.coordenador.nome }}
        </p>
        <a href="{{ .Site.Params.coordenador.lattes }}"
           target="_blank"
           rel="noopener"
           class="text-blue-600 hover:text-blue-800 text-sm">
          {{ i18n "lattes_cv" }}
          <svg class="inline w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
            <path d="M11 3a1 1 0 100 2h2.586l-6.293 6.293a1 1 0 101.414 1.414L15 6.414V9a1 1 0 102 0V4a1 1 0 00-1-1h-5z"/>
          </svg>
        </a>
      </div>
    </div>
  </div>
</section>

<!-- Areas Section -->
<section class="mb-12">
  <h2 class="text-3xl font-bold text-center text-gray-900 mb-8">
    {{ i18n "research_areas" }}
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
    {{ range .Site.Data.areas.areas }}
      {{ partial "area-card.html" (dict "Site" $.Site "area" . "codigo" .codigo "nome_pt" .nome_pt "nome_en" .nome_en "descricao_pt" .descricao_pt "descricao_en" .descricao_en "representante" .representante "cor" .cor "id" .id) }}
    {{ end }}
  </div>
</section>

<!-- Quick Links -->
<section class="mb-12">
  <h2 class="text-3xl font-bold text-center text-gray-900 mb-8">
    {{ if eq .Site.Language.Lang "pt" }}
      Acesso Rápido
    {{ else }}
      Quick Access
    {{ end }}
  </h2>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    <a href="{{ relLangURL "/documentos/" }}"
       class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow text-center">
      <svg class="w-12 h-12 text-blue-600 mx-auto mb-3" fill="currentColor" viewBox="0 0 20 20">
        <path fill-rule="evenodd" d="M4 4a2 2 0 012-2h4.586A2 2 0 0112 2.586L15.414 6A2 2 0 0116 7.414V16a2 2 0 01-2 2H6a2 2 0 01-2-2V4z" clip-rule="evenodd"/>
      </svg>
      <h3 class="font-semibold text-gray-900">{{ i18n "documents" }}</h3>
    </a>

    <a href="{{ relLangURL "/disciplinas/" }}"
       class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow text-center">
      <svg class="w-12 h-12 text-blue-600 mx-auto mb-3" fill="currentColor" viewBox="0 0 20 20">
        <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3zM3.31 9.397L5 10.12v4.102a8.969 8.969 0 00-1.05-.174 1 1 0 01-.89-.89 11.115 11.115 0 01.25-3.762zM9.3 16.573A9.026 9.026 0 007 14.935v-3.957l1.818.78a3 3 0 002.364 0l5.508-2.361a11.026 11.026 0 01.25 3.762 1 1 0 01-.89.89 8.968 8.968 0 00-5.35 2.524 1 1 0 01-1.4 0zM6 18a1 1 0 001-1v-2.065a8.935 8.935 0 00-2-.712V17a1 1 0 001 1z"/>
      </svg>
      <h3 class="font-semibold text-gray-900">{{ i18n "courses" }}</h3>
    </a>

    <a href="{{ relLangURL "/pesquisa/" }}"
       class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow text-center">
      <svg class="w-12 h-12 text-blue-600 mx-auto mb-3" fill="currentColor" viewBox="0 0 20 20">
        <path d="M9 4.804A7.968 7.968 0 005.5 4c-1.255 0-2.443.29-3.5.804v10A7.969 7.969 0 015.5 14c1.669 0 3.218.51 4.5 1.385A7.962 7.962 0 0114.5 14c1.255 0 2.443.29 3.5.804v-10A7.968 7.968 0 0014.5 4c-1.255 0-2.443.29-3.5.804V12a1 1 0 11-2 0V4.804z"/>
      </svg>
      <h3 class="font-semibold text-gray-900">{{ i18n "research" }}</h3>
    </a>

    <a href="{{ relLangURL "/contato/" }}"
       class="bg-white p-6 rounded-lg shadow-md hover:shadow-lg transition-shadow text-center">
      <svg class="w-12 h-12 text-blue-600 mx-auto mb-3" fill="currentColor" viewBox="0 0 20 20">
        <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
        <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
      </svg>
      <h3 class="font-semibold text-gray-900">{{ i18n "contact" }}</h3>
    </a>
  </div>
</section>
{{ end }}
