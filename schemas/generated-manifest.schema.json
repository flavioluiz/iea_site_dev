{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["source", "generated_at", "status", "records", "pipeline_version", "last_complete_run"],
  "properties": {
    "source": { "type": "string", "minLength": 2 },
    "generated_at": { "type": "string", "format": "date-time" },
    "status": { "enum": ["ok", "migrated"] },
    "records": { "type": "integer", "minimum": 0 },
    "pipeline_version": { "type": "string", "minLength": 1 },
    "last_complete_run": { "type": "string", "format": "date-time" },
    "counts": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "curated_ids": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": { "type": "string", "pattern": "^[0-9]+$" }
      }
    }
  }
}
